__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.venv/

# 机器写的状态。三份基线要入库：谁在什么时候放宽了什么，是需要留痕的事实，不是临时产物。
# 注意是 .adone/* 而不是 .adone/——排除目录本身的话 git 根本不会下去看，
# 后面几行 ! 就一条也不生效（而且它不报错，你以为入库了，其实没有）。
.adone/*
!.adone/test-baseline.json
!.adone/policy-baseline.json
!.adone/chain.json
!.adone/new-tests-waiver.json

# 评测台的运行产物。教训要人复制进 bench/lessons/，不从这里自动入库。
bench/runs/
# 本机的 Codex CLI，只给 python -m bench run 用，不入库。
bench/.codex-cli/
